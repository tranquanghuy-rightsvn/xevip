{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/dich-vu-xe-san-bay/:slug",
      "destination": "/dich-vu-xe-san-bay-:slug/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(admin|admin-gas)(/.*)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
        }
      ]
    }
  ]
}
